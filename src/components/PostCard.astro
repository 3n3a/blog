---
// Port of 3n3a.ch's Card.astro (gradient border that slides on hover)
import FormattedDate from './FormattedDate.astro';
import { excerpt, postUrl, readingTime, type Post } from '../lib/posts';

interface Props {
	post: Post;
}

const { post } = Astro.props;
---

<article class="link-card">
	<a href={postUrl(post)}>
		<h2>
			{post.data.title}{' '}<span aria-hidden="true">&rarr;</span>
		</h2>
		<p class="meta">
			<FormattedDate date={post.data.date} /> · {readingTime(post)} min read
			{post.data.draft && <strong> · DRAFT</strong>}
		</p>
		<p class="excerpt">{excerpt(post)}</p>
	</a>
</article>

<style>
	.link-card {
		display: flex;
		padding: 0.15rem;
		background-image: var(--card-gradient);
		background-size: 400%;
		border-radius: 0.5rem;
		background-position: 100%;
		transition: background-position 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.link-card > a {
		width: 100%;
		text-decoration: none;
		line-height: 1.4;
		padding: 1em 1.3em;
		border-radius: 0.35rem;
		color: var(--color-text);
		background-color: var(--card-bg);
	}

	h2 {
		margin: 0;
		font-size: var(--font-size-lg);
		transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}

	h2 span {
		display: inline-block;
		transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.meta {
		margin: 0.4rem 0 0;
	}

	.excerpt {
		margin: 0.75rem 0 0;
	}

	.link-card:is(:hover, :focus-within) {
		background-position: 0;
	}

	.link-card:is(:hover, :focus-within) h2 {
		color: var(--color-accent);
	}

	.link-card:is(:hover, :focus-within) h2 span {
		will-change: transform;
		transform: translateX(2px);
	}
</style>
