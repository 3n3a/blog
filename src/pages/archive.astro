---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getPosts, postUrl, type Post } from '../lib/posts';

const posts = await getPosts();
const byYear = new Map<number, Post[]>();
for (const post of posts) {
	const year = post.data.date.getFullYear();
	byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
---

<BaseLayout title="Archive">
	<h1 class="font-silkscreen">Archive</h1>
	{
		[...byYear].map(([year, yearPosts]) => (
			<section>
				<h2>{year}</h2>
				<ul>
					{yearPosts.map((post) => (
						<li>
							<span class="meta"><FormattedDate date={post.data.date} /></span>
							<a href={postUrl(post)}>{post.data.title}</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</BaseLayout>

<style>
	h1 {
		font-size: var(--font-size-lg-2);
	}

	h2 {
		font-family: var(--font-silkscreen), monospace;
		font-weight: 400;
		border-bottom: 3px dashed var(--card-border);
	}

	ul {
		list-style: none;
		padding: 0;
	}

	li {
		display: grid;
		grid-template-columns: 10em 1fr;
		gap: 1em;
		margin-bottom: 0.5em;
	}

	@media (max-width: 30em) {
		li {
			grid-template-columns: 1fr;
			gap: 0;
		}
	}

	a {
		text-underline-offset: 4px;
		text-decoration-color: var(--card-border);
		text-decoration-thickness: 2px;
	}
</style>
